  "ops": {
    "set_workers": {
      "status": "experimental",
      "note": "v1.1.2a: Building._userDefinedMaxWorkers is the player's worker limit (the UI +/-). Setting the field may not refresh the game's job assignment; test with Settings > Diagnostics > set_workers.",
      "native": [
        {
          "set": "building._userDefinedMaxWorkers",
          "value": "$count"
        }
      ],
      "instant": "same",
      "verify": {
        "member": "building._userDefinedMaxWorkers",
        "equals": "$count",
        "timeout_seconds": 30
      }
    },
    "set_paused": {
      "status": "experimental",
      "note": "v1.1.2a: Building._playerDesiresWorkEnabled is the player's work toggle (false = paused).",
      "native": [
        {
          "set": "building._playerDesiresWorkEnabled",
          "value": "$work_enabled"
        }
      ],
      "instant": "same",
      "verify": {
        "member": "building._playerDesiresWorkEnabled",
        "equals": "$work_enabled",
        "timeout_seconds": 10
      }
    },
    "set_production_limit": {
      "status": "unmapped"
    },
    "set_profession_target": {
      "status": "unmapped"
    },
    "set_rotation": {
      "status": "unmapped"
    },
    "set_work_circle": {
      "status": "unmapped"
    },
    "build": {
      "status": "unmapped",
      "note": "Community mods call BuildManager.Construct(...) returning a GameObject; confirm its parameters with the probe.",
      "native": [
        {
          "call": "BuildManager.Construct",
          "args": [
            "$prefab",
            "$world_pos",
            "$rotation"
          ]
        }
      ],
      "verify": {
        "builtin": "building_at_target"
      }
    },
    "relocate": {
      "status": "unmapped",
      "verify": {
        "builtin": "building_at_target"
      }
    },
    "demolish": {
      "status": "unmapped",
      "verify": {
