  "ops": {
    "set_workers": {
      "status": "experimental",
      "note": "Resource.userDefinedMaxWorkers setter: validates 0..maxWorkers and notifies the game (OnUserDefinedMaxWorkersUpdated), as the UI +/- does.",
      "native": [
        {
          "set": "building.userDefinedMaxWorkers",
          "value": "$count"
        }
      ],
      "instant": "same",
      "verify": {
        "member": "building.userDefinedMaxWorkers",
        "equals": "$count",
        "timeout_seconds": 20
      }
    },
    "set_paused": {
      "status": "experimental",
      "note": "Building.SetWorkEnabled(value, isPlayerDecision: true), the work toggle's code path.",
      "native": [
        {
          "call": "building.SetWorkEnabled",
          "args": [
            "$work_enabled",
            true
          ]
        }
      ],
      "instant": "same",
      "verify": {
        "member": "building.playerDesiresWorkEnabled",
        "equals": "$work_enabled",
        "timeout_seconds": 20
      }
    },
    "set_work_circle": {
      "status": "experimental",
      "note": "WorkArea.SetCenterPoint(world position) on the building's WorkArea component.",
      "native": [
        {
          "call": "building.<WorkArea>.SetCenterPoint",
          "args": [
            "$world_pos"
          ]
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "work_center_at",
        "timeout_seconds": 20
      }
    },
    "set_production_limit": {
      "status": "experimental",
      "note": "ResourceManager.itemNameToItemInfoDict[item]: maxQuota = limit, areProductionLimitsEnabled = limit > 0 (limit 0 removes it).",
      "native": [
        {
          "builtin": "production_limit"
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "production_limit",
        "timeout_seconds": 20
      }
    },
    "set_profession_target": {
      "status": "dropped",
      "note": "Farthest Frontier v1.1.x has no per-profession target: jobs follow each building's worker limit (use set_workers)."
    },
    "set_rotation": {
      "status": "experimental",
      "note": "Cropfield.cropScheduler: WipeScheduledItem then AttemptToAddCropToSchedule(year, crop record name) / AttemptToAddFieldWorkToSchedule for maintenance.",
      "native": [
        {
          "builtin": "crop_rotation"
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "rotation_is",
        "timeout_seconds": 20
      }
    },
    "build": {
      "status": "experimental",
      "note": "Input_PlaceBuilding.Place: ConstructionData(CONSTRUCT) -> BuildManager.Construct. Native queues a build site; Instant places the finished building.",
      "native": [
        {
          "builtin": "construct"
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "building_at_target"
      }
    },
    "relocate": {
      "status": "experimental",
      "note": "Input_RelocateObject: deconstruction + construction ConstructionData(RELOCATE) -> BuildManager.Relocate. Costs workRequiredToConstruct and goldRequiredToRelocate like the game.",
      "native": [
        {
          "builtin": "relocate"
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "building_at_target"
      }
    },
    "demolish": {
      "status": "experimental",
      "note": "Building.OnDeleteConfirmed: the delete button's salvage path (deconstruct site, refund).",
      "native": [
        {
          "call": "building.OnDeleteConfirmed",
          "args": []
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "building_gone"
      }
    },
    "field_remove": {
      "status": "experimental",
      "note": "Cropfield.OnConfirmDelete.",
      "native": [
        {
          "call": "field.OnConfirmDelete",
          "args": []
        }
      ],
      "instant": "same",
      "verify": {
        "builtin": "field_gone"
      }
    },
    "field_create": {
      "status": "unmapped",
      "note": "Fields are placed through Input_PlaceCropfield with a TerrainGridData of valid cells; not mapped yet.",
      "verify": {
        "builtin": "field_present"
      }
    },
    "field_resize": {
      "status": "unmapped",
      "note": "Cropfield.Expand / AddExpandedArea need a TerrainGridData; not mapped yet."
    },
    "road_add": {
      "status": "unmapped",
      "note": "Roads are spline/segment placements (BuildManager.BuildImmediateSegments); not mapped yet."
    },
    "road_remove": {
      "status": "unmapped",
      "note": "Road pieces are salvaged one by one; not mapped yet."
    },
    "clear_area": {
      "status": "unmapped",
      "note": "BuildManager.SelectTreesAndMarkToClear(rects, priority) exists; not mapped yet."
    },
    "flatten": {
      "status": "unmapped",
      "note": "Terrain smoothing runs inside construction; no standalone flatten; not mapped."
    }
  },
  "procedures": {
    "save": {
      "status": "experimental",
      "note": "SaveManager.Save(name, isHighMemoryAutoSave: false, isAutoSave: false); saving runs as a coroutine.",
      "steps": [
        {
          "call": "SaveManager.Save",
          "args": [
            "$name",
            false,
            false
          ]
        }
      ]
    },
    "load": {
      "status": "experimental",
      "note": "CESceneManager.LoadFromWithinGame(name): the in-game Load path (reloads the scene).",
      "steps": [
