<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MelonLoader plugin (goes in Plugins/). Plugins load before mods, so this one can replace
    Mods/FrontierArchitect.dll with a newer release before the game ever loads it.
    Kept deliberately small and stable: it rarely needs to change itself.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>FrontierArchitect.Updater</AssemblyName>
    <RootNamespace>FrontierArchitect.Updater</RootNamespace>
    <FaBuildInfoNamespace>FrontierArchitect.Updater</FaBuildInfoNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.6" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\FrontierArchitect.Core\Json\*.cs" LinkBase="Core\Json" />
    <Compile Include="..\FrontierArchitect.Core\Updates\*.cs" LinkBase="Core\Updates" />
    <Compile Include="..\FrontierArchitect.Core\Net\*.cs" LinkBase="Core\Net" />
  </ItemGroup>
</Project>
